          "stringUnit" : {
            "state" : "translated",
            "value" : "Mailbell deletes this account's sign-in from your Keychain and stops watching it. Nothing in Gmail changes, and no mail is deleted."
          }
        }
      }
    },
    "Mailbell is in public beta and its Google OAuth client is not verified by Google yet, so Google shows an \"unverified app\" screen during sign-in and caps unverified apps at 100 new users. Revoke access at any time in your Google Account." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mailbell is in public beta and its Google OAuth client is not verified by Google yet, so Google shows an \"unverified app\" screen during sign-in and caps unverified apps at 100 new users. Revoke access at any time in your Google Account."
          }
        }
      }
    },
