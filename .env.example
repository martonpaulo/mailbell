MAILBELL_GOOGLE_CLIENT_ID=
MAILBELL_GOOGLE_CLIENT_SECRET=
# Optional. May only restate the identifier already in Resources/Info.plist;
# packaging rejects a different value rather than minting a second Mailbell.
MAILBELL_BUNDLE_ID=
MAILBELL_CODE_SIGN_IDENTITY=
# Optional. notarytool Keychain profile shared by every app; default skd-notary.
NOTARY_PROFILE=
